#define GIT_INFO
#include "gitinfo.h"

#ifdef GIT_COMMIT_YEAR
    // Stringify so string concatenation works with windres/MinGW (where
    // GIT_COMMIT_YEAR is a bare integer, not a quoted string).
    #define CUR_YEAR_STRINGIFY_HELPER(x) #x
    #define CUR_YEAR_STRINGIFY(x)        CUR_YEAR_STRINGIFY_HELPER(x)
    #define CUR_YEAR                     CUR_YEAR_STRINGIFY(GIT_COMMIT_YEAR)
#else
    #define CUR_YEAR                "@MIXXX_YEAR@"
#endif

#ifdef GIT_DIRTY
    #define VER_PATCHED VS_FF_PATCHED
#else
    #define VER_PATCHED 0
#endif

#ifdef GIT_COMMIT_COUNT
    #define VER_FILEVERSION         @MIXXX_FILEVERSION@,GIT_COMMIT_COUNT
    #define VER_PRODUCTVERSION      @MIXXX_PRODUCTVERSION@,GIT_COMMIT_COUNT
#else
    #define VER_FILEVERSION         @MIXXX_FILEVERSION@
    #define VER_PRODUCTVERSION      @MIXXX_PRODUCTVERSION@
#endif
#define MIXXX_VERSION               "@MIXXX_VERSION@"

#if @MIXXX_DEBUG@
    #define DEBUG
#endif

#if @MIXXX_PRERELEASE@
    #define PRERELEASE
#endif
